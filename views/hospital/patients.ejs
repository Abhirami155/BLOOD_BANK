<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Patients Management - Blood Bank MS</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="dashboard-layout">
    <%- include('../partials/sidebar') %>

    <main class="main-content">
        <header style="margin-bottom: 2rem;">
            <h1>Clinical Patient Management</h1>
            <p style="color: var(--text-muted);">Track and manage your hospital's admitted patients</p>
        </header>

        <div style="display: grid; grid-template-columns: 1.5fr 1fr; gap: 2rem;">
            <!-- Patient List -->
            <section class="glass-card">
                <h3>Admitted Patients</h3>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Age</th>
                            <th>Gender</th>
                            <th>Blood Group</th>
                            <th>Assigned Doctor</th>
                            <th>Contact</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (patients.length === 0) { %>
                            <tr><td colspan="6" style="text-align: center; color: var(--text-muted);">No patients registered yet</td></tr>
                        <% } else { %>
                            <% patients.forEach(p => { %>
                                <tr>
                                    <td style="font-weight: 600;"><%= p.name %></td>
                                    <td><%= p.age %></td>
                                    <td><%= p.gender %></td>
                                    <td><span style="color: var(--primary); font-weight: 700;"><%= p.blood_group %></span></td>
                                    <td><%= p.doctor_name ? 'Dr. ' + p.doctor_name : '<span style="color:var(--text-muted)">Unassigned</span>' %></td>
                                    <td><%= p.contact %></td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </section>

            <!-- Add Patient Form -->
            <section class="glass-card">
                <h3>Register New Patient</h3>
                <form action="/hospital/patients/add" method="POST" style="margin-top: 1rem;">
                    <div class="form-group">
                        <label>Patient Name</label>
                        <input type="text" name="name" class="form-control" placeholder="John Doe" required>
                    </div>
                    <div class="form-row" style="display: flex; gap: 1rem;">
                        <div class="form-group" style="flex: 1;">
                            <label>Age</label>
                            <input type="number" name="age" class="form-control" placeholder="25" required>
                        </div>
                        <div class="form-group" style="flex: 1;">
                            <label>Gender</label>
                            <select name="gender" class="form-control" required>
                                <option>Male</option>
                                <option>Female</option>
                                <option>Other</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Blood Group</label>
                        <select name="blood_group" class="form-control" required>
                            <option>A+</option><option>A-</option><option>B+</option><option>B-</option>
                            <option>AB+</option><option>AB-</option><option>O+</option><option>O-</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Assigned Doctor</label>
                        <select name="assigned_doctor_id" class="form-control">
                            <option value="">— No Doctor Assigned —</option>
                            <% doctors.forEach(d => { %>
                                <option value="<%= d.id %>">Dr. <%= d.name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Contact Number</label>
                        <input type="text" name="contact_number" class="form-control" placeholder="555-0199" required>
                    </div>

                    <hr style="margin: 1.5rem 0; border: none; border-top: 1px dashed var(--border-color);">
                    <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1rem;">Portal Access Credentials</p>

                    <div class="form-group">
                        <label>Patient Email</label>
                        <input type="email" name="email" class="form-control" placeholder="patient@example.com" required>
                    </div>

                    <div class="form-row" style="display: flex; gap: 1rem;">
                        <div class="form-group" style="flex: 1;">
                            <label>Temporary Password</label>
                            <input type="password" name="password" id="password" class="form-control" placeholder="Enter temporary password" required>
                        </div>
                        <div class="form-group" style="flex: 1;">
                            <label>Confirm Password</label>
                            <input type="password" name="confirm_password" id="confirm_password" class="form-control" placeholder="Confirm password" required>
                        </div>
                    </div>

                    <button type="submit" id="submitBtn" class="btn btn-primary" style="width: 100%;">Admit Patient</button>
                </form>
            </section>
        </div>
    </main>

    <!-- Success Modal -->
    <div id="successModal" class="modal-overlay" style="display: none;">
        <div class="glass-card modal-content" style="max-width: 450px; text-align: center;">
            <div style="font-size: 3rem; color: #4CAF50; margin-bottom: 1rem;">✅</div>
            <h3 id="modalTitle">Patient Registered Successfully</h3>
            <p id="modalMessage" style="margin: 1rem 0; color: var(--text-muted);">
                Patient account created successfully.
            </p>
            
            <div style="background: rgba(0,0,0,0.2); padding: 1rem; border-radius: 8px; text-align: left; margin-bottom: 1.5rem;">
                <p style="font-size: 0.9rem; margin-bottom: 0.5rem;"><strong>Login Credentials:</strong></p>
                <p style="font-size: 0.85rem; margin-bottom: 0.2rem;">Email: <span id="displayEmail" style="color: var(--primary);"></span></p>
                <p style="font-size: 0.85rem;">Password: <span id="displayPassword" style="color: var(--primary);"></span></p>
            </div>

            <p style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 1.5rem;">
                Provide these credentials to the patient for portal access.
            </p>

            <button onclick="window.location.reload()" class="btn btn-primary" style="width: 100%;">OK</button>
        </div>
    </div>

    <style>
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.7);
            backdrop-filter: blur(5px);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1000;
        }
        .modal-content {
            padding: 2rem;
            animation: slideUp 0.3s ease-out;
        }
        @keyframes slideUp {
            from { transform: translateY(20px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }
    </style>

    <script>
        document.querySelector('form').addEventListener('submit', async (e) => {
            e.preventDefault();
            const form = e.target;
            const submitBtn = document.getElementById('submitBtn');
            const password = document.getElementById('password').value;
            const confirmPassword = document.getElementById('confirm_password').value;

            if (password !== confirmPassword) {
                alert('Passwords do not match');
                return;
            }

            submitBtn.disabled = true;
            submitBtn.innerText = 'Processing...';

            const formData = new FormData(form);
            const rawData = Object.fromEntries(formData.entries());
            
            // Map to expected payload structure
            const payload = {
                name: rawData.name,
                age: rawData.age,
                gender: rawData.gender,
                blood_group: rawData.blood_group,
                assigned_doctor_id: rawData.assigned_doctor_id,
                contact_number: rawData.contact_number,
                email: rawData.email,
                password: rawData.password
            };

            try {
                const response = await fetch('/hospital/patients/add', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });

                // Handle session expiry
                if (response.status === 401) {
                    alert('Your session has expired. Please log in again.');
                    window.location.href = '/auth/login';
                    return;
                }

                // Try to parse JSON — if it fails log the raw response
                let result;
                const rawText = await response.text();
                try {
                    result = JSON.parse(rawText);
                } catch (parseErr) {
                    console.error('Non-JSON response (status ' + response.status + '):', rawText.substring(0, 500));
                    alert('Server error (HTTP ' + response.status + '). Check console for details. Please try again.');
                    submitBtn.disabled = false;
                    submitBtn.innerText = 'Admit Patient';
                    return;
                }

                if (response.ok) {
                    document.getElementById('displayEmail').innerText = payload.email;
                    document.getElementById('displayPassword').innerText = payload.password;
                    document.getElementById('successModal').style.display = 'flex';
                } else {
                    const errorMsg = result.stack ? result.message + '\n\nStack: ' + result.stack : result.message || 'Unable to create patient account';
                    alert(errorMsg);
                    submitBtn.disabled = false;
                    submitBtn.innerText = 'Admit Patient';
                }
            } catch (err) {
                console.error('Fetch error:', err);
                alert('Network error: Could not reach the server. Is the server running?');
                submitBtn.disabled = false;
                submitBtn.innerText = 'Admit Patient';
            }
        });
    </script>
</body>
</html>
