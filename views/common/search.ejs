<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Search Blood - Blood Bank MS</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="dashboard-layout">
    <%- include('../partials/sidebar') %>

    <main class="main-content">
        <header style="margin-bottom: 2rem;">
            <h1>Global Blood Search</h1>
            <p style="color: var(--text-muted);">Find blood inventory across all registered hospitals</p>
        </header>

        <!-- Search Form -->
        <section class="glass-card" style="margin-bottom: 2rem;">
            <form action="/common/search" method="POST" style="display: grid; grid-template-columns: 1fr 2fr auto; gap: 1.5rem; align-items: flex-end;">
                <div class="form-group" style="margin: 0;">
                    <label>Blood Group</label>
                    <select name="blood_group" class="form-control" style="min-width: 120px;" required>
                        <option value="A+" <%= locals.searchQuery && searchQuery.blood_group === 'A+' ? 'selected' : '' %>>A+</option>
                        <option value="A-" <%= locals.searchQuery && searchQuery.blood_group === 'A-' ? 'selected' : '' %>>A-</option>
                        <option value="B+" <%= locals.searchQuery && searchQuery.blood_group === 'B+' ? 'selected' : '' %>>B+</option>
                        <option value="B-" <%= locals.searchQuery && searchQuery.blood_group === 'B-' ? 'selected' : '' %>>B-</option>
                        <option value="AB+" <%= locals.searchQuery && searchQuery.blood_group === 'AB+' ? 'selected' : '' %>>AB+</option>
                        <option value="AB-" <%= locals.searchQuery && searchQuery.blood_group === 'AB-' ? 'selected' : '' %>>AB-</option>
                        <option value="O+" <%= locals.searchQuery && searchQuery.blood_group === 'O+' ? 'selected' : '' %>>O+</option>
                        <option value="O-" <%= locals.searchQuery && searchQuery.blood_group === 'O-' ? 'selected' : '' %>>O-</option>
                    </select>
                </div>
                <div class="form-group" style="margin: 0;">
                    <label>City</label>
                    <input type="text" name="city" class="form-control" style="min-width: 200px;" placeholder="Enter City" value="<%= locals.searchQuery ? searchQuery.city : '' %>">
                </div>
                <button type="submit" class="btn btn-primary btn-inline" style="height: 48px;">Search Blood</button>
            </form>
        </section>

        <!-- Results Table -->
        <% if (searchResults !== null) { %>
            <section class="glass-card">
                <h3>Search Results for <%= searchQuery.blood_group %> in <%= searchQuery.city || 'all cities' %></h3>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Hospital</th>
                            <th>City</th>
                            <th>Available Units</th>
                            <th>Contact</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (searchResults.length === 0) { %>
                            <tr><td colspan="4" style="text-align: center; color: var(--text-muted);">No availability found based on your criteria</td></tr>
                        <% } else { %>
                            <% searchResults.forEach(res => { %>
                                <tr>
                                    <td style="font-weight: 600;"><%= res.hospital_name %></td>
                                    <td><%= res.city %></td>
                                    <td style="font-weight: 700; color: var(--primary);"><%= res.quantity %> Units</td>
                                    <td><%= res.contact %></td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </section>
        <% } %>
    </main>
</body>
</html>
