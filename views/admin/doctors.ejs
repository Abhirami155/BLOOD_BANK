<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Doctors Management - Blood Bank MS</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="dashboard-layout">
    <%- include('../partials/sidebar') %>

    <main class="main-content">
        <header style="margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: flex-end;">
            <div>
                <h1>Registered Doctors</h1>
                <p style="color: var(--text-muted);">View all specialized medical staff in the network</p>
            </div>
            <div style="display: flex; gap: 1rem;">
                <select id="statusFilter" class="form-control" style="width: 200px;" onchange="filterDoctors()">
                    <option value="all">All Statuses</option>
                    <option value="active">🟢 Active</option>
                    <option value="inactive">🔴 Inactive</option>
                </select>
                <input type="text" id="doctorSearch" class="form-control" placeholder="Search doctors..." style="width: 250px;" onkeyup="filterDoctors()">
            </div>
        </header>

        <section class="glass-card">
            <h3>Medical Staff Registry</h3>
            <table class="data-table" id="doctorTable">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Hospital</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (doctors.length === 0) { %>
                        <tr><td colspan="5" style="text-align: center; color: var(--text-muted);">No doctors found</td></tr>
                    <% } else { %>
                        <% doctors.forEach(d => { %>
                            <tr class="doctor-row" data-status="<%= d.status %>">
                                <td>#<%= d.id %></td>
                                <td style="font-weight: 600;" class="doctor-name"><%= d.name %></td>
                                <td><%= d.hospital_name %></td>
                                <td><span class="badge badge-<%= d.status || 'active' %>"><%= (d.status || 'active').toUpperCase() %></span></td>
                                <td>
                                    <div style="display: flex; gap: 0.5rem;">
                                        <button class="action-btn action-btn-view" onclick="viewDetails('<%= d.user_id %>', 'doctor')">👁️ View</button>
                                        <% if ((d.status || 'active') === 'active') { %>
                                            <button class="action-btn action-btn-warning" onclick="toggleStatus('<%= d.user_id %>', 'inactive')">⛔ Deactivate</button>
                                        <% } else { %>
                                            <button class="action-btn action-btn-success" onclick="toggleStatus('<%= d.user_id %>', 'active')">✅ Reactivate</button>
                                        <% } %>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </section>
    </main>

    <!-- Details Modal -->
    <div class="modal-overlay" id="detailsModal">
        <div class="modal-container glass-card">
            <button class="modal-close" onclick="closeModal()">×</button>
            <h2 id="modalTitle">Doctor Details</h2>
            <div id="modalBody">
                <!-- Content injected by JS -->
            </div>
        </div>
    </div>

    <script>
        function filterDoctors() {
            const status = document.getElementById('statusFilter').value;
            const search = document.getElementById('doctorSearch').value.toLowerCase();
            const rows = document.querySelectorAll('.doctor-row');

            rows.forEach(row => {
                const rowStatus = row.dataset.status;
                const rowName = row.querySelector('.doctor-name').innerText.toLowerCase();
                const matchesStatus = status === 'all' || rowStatus === status;
                const matchesSearch = rowName.includes(search);
                row.style.display = (matchesStatus && matchesSearch) ? '' : 'none';
            });
        }

        async function viewDetails(userId, role) {
            try {
                const res = await fetch(`/admin/details/${role}/${userId}`);
                const data = await res.json();
                
                let body = `
                    <div class="details-grid">
                        <div class="details-item"><label>Full Name</label><p>${data.name}</p></div>
                        <div class="details-item"><label>Specialization</label><p>${data.specialization}</p></div>
                        <div class="details-item"><label>Assigned Hospital</label><p>${data.hospital_name}</p></div>
                        <div class="details-item"><label>Contact Info</label><p>${data.contact}</p></div>
                    </div>
                `;
                
                document.getElementById('modalTitle').innerText = `Doctor Profile: ${data.name}`;
                document.getElementById('modalBody').innerHTML = body;
                document.getElementById('detailsModal').classList.add('active');
            } catch (err) {
                alert('Error fetching details');
            }
        }

        function closeModal() {
            document.getElementById('detailsModal').classList.remove('active');
        }

        async function toggleStatus(userId, newStatus) {
            if (!confirm(`Are you sure you want to ${newStatus === 'inactive' ? 'deactivate' : 'reactivate'} this doctor account?`)) return;
            try {
                const res = await fetch('/admin/toggle-status', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userId, newStatus })
                });
                const data = await res.json();
                if (data.success) location.reload();
                else alert('Operation failed');
            } catch (err) {
                alert('Error toggling status');
            }
        }

    </script>
</body>
</html>
