<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Patients Overview - Blood Bank MS</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="dashboard-layout">
    <%- include('../partials/sidebar') %>

    <main class="main-content">
        <header style="margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: flex-end;">
            <div>
                <h1>Patients Overview</h1>
                <p style="color: var(--text-muted);">All registered patients across the network</p>
            </div>
            <div style="display: flex; gap: 1rem;">
                <select id="statusFilter" class="form-control" style="width: 200px;" onchange="filterPatients()">
                    <option value="all">All Statuses</option>
                    <option value="active">🟢 Active</option>
                    <option value="inactive">🔴 Inactive</option>
                </select>
                <input type="text" id="patientSearch" class="form-control" placeholder="Search patients..." style="width: 250px;" onkeyup="filterPatients()">
            </div>
        </header>

        <section class="glass-card">
            <h3>Registered Patients Registry</h3>
            <table class="data-table" id="patientTable">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Blood Group</th>
                        <th>Hospital</th>
                        <th>Assigned Doctor</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (patients.length === 0) { %>
                        <tr><td colspan="6" style="text-align: center; color: var(--text-muted);">No patients registered</td></tr>
                    <% } else { %>
                        <% patients.forEach(p => { %>
                            <tr class="patient-row" data-status="<%= p.status %>">
                                <td style="font-weight: 600;" class="patient-name"><%= p.name %></td>
                                <td><span style="color: var(--primary); font-weight: 800;"><%= p.blood_group %></span></td>
                                <td><%= p.hospital_name %></td>
                                <td><%= p.doctor_name ? 'Dr. ' + p.doctor_name : '<span style="color:var(--text-muted)">Unassigned</span>' %></td>
                                <td><span class="badge badge-<%= p.status || 'active' %>"><%= (p.status || 'active').toUpperCase() %></span></td>
                                <td>
                                    <div style="display: flex; gap: 0.5rem;">
                                        <button class="action-btn action-btn-view" onclick="viewDetails('<%= p.user_id %>', 'patient')">👁️ View</button>
                                        <% if ((p.status || 'active') === 'active') { %>
                                            <button class="action-btn action-btn-warning" onclick="toggleStatus('<%= p.user_id %>', 'inactive')">⛔ Deactivate</button>
                                        <% } else { %>
                                            <button class="action-btn action-btn-success" onclick="toggleStatus('<%= p.user_id %>', 'active')">✅ Reactivate</button>
                                        <% } %>
                                        <button class="action-btn action-btn-danger" onclick="deleteUser('<%= p.user_id %>')">🗑️ Delete</button>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </section>
    </main>

    <!-- Details Modal -->
    <div class="modal-overlay" id="detailsModal">
        <div class="modal-container glass-card">
            <button class="modal-close" onclick="closeModal()">×</button>
            <h2 id="modalTitle">Patient Details</h2>
            <div id="modalBody">
                <!-- Content injected by JS -->
            </div>
        </div>
    </div>

    <script>
        function filterPatients() {
            const status = document.getElementById('statusFilter').value;
            const search = document.getElementById('patientSearch').value.toLowerCase();
            const rows = document.querySelectorAll('.patient-row');

            rows.forEach(row => {
                const rowStatus = row.dataset.status;
                const rowName = row.querySelector('.patient-name').innerText.toLowerCase();
                const matchesStatus = status === 'all' || rowStatus === status;
                const matchesSearch = rowName.includes(search);
                row.style.display = (matchesStatus && matchesSearch) ? '' : 'none';
            });
        }

        async function viewDetails(userId, role) {
            try {
                const res = await fetch(`/admin/details/${role}/${userId}`);
                const data = await res.json();
                
                let body = `
                    <div class="details-grid">
                        <div class="details-item"><label>Name</label><p>${data.name}</p></div>
                        <div class="details-item"><label>Blood Group</label><p>${data.blood_group}</p></div>
                        <div class="details-item"><label>Age / Gender</label><p>${data.age} / ${data.gender}</p></div>
                        <div class="details-item"><label>Assigned Doctor</label><p>${data.doctor_name ? 'Dr. ' + data.doctor_name : 'N/A'}</p></div>
                        <div class="details-item"><label>Hospital</label><p>${data.hospital_name}</p></div>
                        <div class="details-item"><label>Contact</label><p>${data.contact || 'N/A'}</p></div>
                    </div>
                    <div class="modal-section-title">Blood Request History</div>
                    <table class="data-table" style="font-size: 0.85rem;">
                        <thead><tr><th>Date</th><th>Group</th><th>Qty</th><th>Status</th></tr></thead>
                        <tbody>
                            ${data.history && data.history.length > 0 ? 
                                data.history.map(h => `<tr><td>${new Date(h.created_at).toLocaleDateString()}</td><td>${h.blood_group}</td><td>${h.quantity}</td><td>${h.status}</td></tr>`).join('') 
                                : '<tr><td colspan="4" style="text-align:center">No requests found</td></tr>'}
                        </tbody>
                    </table>
                `;
                
                document.getElementById('modalTitle').innerText = `Patient Profile: ${data.name}`;
                document.getElementById('modalBody').innerHTML = body;
                document.getElementById('detailsModal').classList.add('active');
            } catch (err) {
                alert('Error fetching details');
            }
        }

        function closeModal() {
            document.getElementById('detailsModal').classList.remove('active');
        }

        async function toggleStatus(userId, newStatus) {
            if (!confirm(`Are you sure you want to ${newStatus === 'inactive' ? 'deactivate' : 'reactivate'} this account?`)) return;
            try {
                const res = await fetch('/admin/toggle-status', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userId, newStatus })
                });
                const data = await res.json();
                if (data.success) location.reload();
                else alert('Operation failed');
            } catch (err) {
                alert('Error toggling status');
            }
        }

        async function deleteUser(userId) {
            if (!confirm('This action will permanently delete the account and associated access credentials. Continue?')) return;
            try {
                const res = await fetch('/admin/delete-user', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userId })
                });
                const data = await res.json();
                if (data.success) location.reload();
                else alert('Delete failed');
            } catch (err) {
                alert('Error deleting user');
            }
        }
    </script>
</body>
</html>
