<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hospitals Management - Blood Bank MS</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="dashboard-layout">
    <%- include('../partials/sidebar') %>

    <main class="main-content">
        <header style="margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: flex-end;">
            <div>
                <h1>Hospitals Network</h1>
                <p style="color: var(--text-muted);">Manage and track registered hospitals</p>
            </div>
            <div style="display: flex; gap: 1rem;">
                <select id="statusFilter" class="form-control" style="width: 200px;" onchange="filterHospitals()">
                    <option value="all">All Statuses</option>
                    <option value="active">🟢 Active</option>
                    <option value="inactive">🔴 Inactive</option>
                </select>
                <input type="text" id="hospitalSearch" class="form-control" placeholder="Search hospitals..." style="width: 250px;" onkeyup="filterHospitals()">
            </div>
        </header>

        <section class="glass-card">
            <h3>Registered Hospitals</h3>
            <table class="data-table" id="hospitalTable">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>City</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (hospitals.length === 0) { %>
                        <tr><td colspan="5" style="text-align: center; color: var(--text-muted);">No hospitals found</td></tr>
                    <% } else { %>
                        <% hospitals.forEach(h => { %>
                            <tr class="hospital-row" data-status="<%= h.status %>">
                                <td>#<%= h.id %></td>
                                <td style="font-weight: 600;" class="hospital-name"><%= h.name %></td>
                                <td><%= h.city %></td>
                                <td><span class="badge badge-<%= h.status || 'active' %>"><%= (h.status || 'active').toUpperCase() %></span></td>
                                <td>
                                    <div style="display: flex; gap: 0.5rem;">
                                        <button class="action-btn action-btn-view" onclick="viewDetails('<%= h.id %>', 'hospital')">👁️ View</button>
                                        <% if ((h.status || 'active') === 'active') { %>
                                            <button class="action-btn action-btn-warning" onclick="toggleStatus('<%= h.user_id %>', 'inactive')">⛔ Deactivate</button>
                                        <% } else { %>
                                            <button class="action-btn action-btn-success" onclick="toggleStatus('<%= h.user_id %>', 'active')">✅ Reactivate</button>
                                        <% } %>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </section>
    </main>

    <!-- Details Modal -->
    <div class="modal-overlay" id="detailsModal">
        <div class="modal-container glass-card">
            <button class="modal-close" onclick="closeModal()">×</button>
            <h2 id="modalTitle">Hospital Details</h2>
            <div id="modalBody">
                <!-- Content injected by JS -->
            </div>
        </div>
    </div>

    <script>
        function filterHospitals() {
            const status = document.getElementById('statusFilter').value;
            const search = document.getElementById('hospitalSearch').value.toLowerCase();
            const rows = document.querySelectorAll('.hospital-row');

            rows.forEach(row => {
                const rowStatus = row.dataset.status;
                const rowName = row.querySelector('.hospital-name').innerText.toLowerCase();
                const matchesStatus = status === 'all' || rowStatus === status;
                const matchesSearch = rowName.includes(search);
                row.style.display = (matchesStatus && matchesSearch) ? '' : 'none';
            });
        }

        async function viewDetails(targetId, role) {
            console.log(`[AdminAudit] Selected ${role} ID:`, targetId);
            const modalBody = document.getElementById('modalBody');
            const modalTitle = document.getElementById('modalTitle');
            const modal = document.getElementById('detailsModal');

            // Show Loading State
            modalTitle.innerText = 'Loading...';
            modalBody.innerHTML = '<div style="padding: 2rem; text-align: center; color: var(--text-muted);">Retrieving hospital clinical data...</div>';
            modal.classList.add('active');

            try {
                const url = role === 'hospital' ? `/api/hospitals/${targetId}` : `/admin/details/${role}/${targetId}`;
                const res = await fetch(url);
                const data = await res.json();
                
                if (data.error) {
                    modalBody.innerHTML = `<div style="padding: 2rem; text-align: center; color: var(--error);">${data.error}</div>`;
                    return;
                }

                const requestSummary = data.requestStats ? data.requestStats.map(s => `${s.status.toUpperCase()}: ${s.count}`).join(' | ') : 'No requests';
                
                let body = `
                    <div class="details-grid">
                        <div class="details-item"><label>Hospital Name</label><p>${data.name}</p></div>
                        <div class="details-item"><label>Location</label><p>${data.city}</p></div>
                        <div class="details-item"><label>Contact Email</label><p>${data.email || 'N/A'}</p></div>
                        <div class="details-item"><label>Contact Phone</label><p>${data.contact}</p></div>
                        <div class="details-item" style="grid-column: span 2;"><label>Full Address</label><p>${data.address}</p></div>
                    </div>

                    <div class="modal-section-title">Operational Statistics</div>
                    <div class="details-grid" style="grid-template-columns: repeat(3, 1fr);">
                        <div class="details-item"><label>Total Doctors</label><p>${data.doctorCount}</p></div>
                        <div class="details-item"><label>Total Patients</label><p>${data.patientCount}</p></div>
                        <div class="details-item"><label>Unique Donors</label><p>${data.donorCount}</p></div>
                    </div>

                    <div class="modal-section-title">Blood Request Overview</div>
                    <div style="background: rgba(255,255,255,0.05); padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem;">
                        <p style="font-size: 0.85rem; color: var(--text-muted);">${requestSummary}</p>
                    </div>

                    <div class="modal-section-title">Live Inventory Summary</div>
                    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-top: 1rem;">
                        ${data.inventory && data.inventory.length > 0 ? 
                            data.inventory.map(i => `
                                <div style="background: rgba(255,255,255,0.05); padding: 0.75rem; border-radius: 8px; text-align: center; border-left: 2px solid var(--primary);">
                                    <div style="font-size: 0.75rem; color: var(--text-muted);">${i.blood_group}</div>
                                    <div style="font-weight: 700; color: var(--primary);">${i.quantity} Units</div>
                                </div>
                            `).join('') 
                            : '<p style="grid-column: span 4; text-align:center; color: var(--text-muted); padding: 1rem;">No inventory recorded for this facility</p>'}
                    </div>
                `;
                
                modalTitle.innerText = `Hospital Audit: ${data.name}`;
                modalBody.innerHTML = body;
            } catch (err) {
                modalBody.innerHTML = '<div style="padding: 2rem; text-align: center; color: var(--error);">Unable to load hospital details. Please check connection and retry.</div>';
            }
        }

        function closeModal() {
            document.getElementById('detailsModal').classList.remove('active');
        }

        async function toggleStatus(userId, newStatus) {
            if (!confirm(`Are you sure you want to ${newStatus === 'inactive' ? 'deactivate' : 'reactivate'} this hospital account?`)) return;
            try {
                const res = await fetch('/admin/toggle-status', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userId, newStatus })
                });
                const data = await res.json();
                if (data.success) location.reload();
                else alert('Operation failed');
            } catch (err) {
                alert('Error toggling status');
            }
        }

        async function deleteUser(userId) {
            if (!confirm('This action will permanently delete the account and associated access credentials. Continue?')) return;
            try {
                const res = await fetch('/admin/delete-user', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userId })
                });
                const data = await res.json();
                if (data.success) location.reload();
                else alert('Delete failed');
            } catch (err) {
                alert('Error deleting user');
            }
        }
    </script>
</body>
</html>
