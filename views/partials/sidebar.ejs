<aside class="sidebar">
    <div class="auth-logo" style="margin-bottom: 3rem; font-size: 1.5rem;">🩸 BloodBank</div>
    
    <nav>
        <div style="font-size: 0.75rem; color: var(--text-muted); margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 0.05em;">Main Dashboard</div>
        <% if (user.role === 'admin') { %>
            <a href="/admin/dashboard" class="nav-link">Control Center</a>
            <a href="/admin/hospitals" class="nav-link">Hospitals List</a>
            <a href="/admin/doctors" class="nav-link">Doctors List</a>
            <a href="/admin/donors" class="nav-link">Donors List</a>
        <% } else if (user.role === 'hospital') { %>
            <a href="/hospital/dashboard" class="nav-link">Dashboard</a>
            <a href="/hospital/inventory" class="nav-link">My Inventory</a>
            <a href="/hospital/patients" class="nav-link">Patient Records</a>
        <% } else if (user.role === 'doctor') { %>
            <a href="/doctor/dashboard" class="nav-link">Dashboard</a>
            <a href="/doctor/patients" class="nav-link">Patient History</a>
        <% } else if (user.role === 'donor') { %>
            <a href="/donor/dashboard" class="nav-link">Dashboard</a>
            <a href="/donor/history" class="nav-link">My Donations</a>
        <% } else if (user.role === 'patient') { %>
            <a href="/patient/dashboard" class="nav-link">Dashboard</a>
            <a href="/patient/requests" class="nav-link">My Requests</a>
        <% } %>

        <div style="margin-top: 2rem; font-size: 0.75rem; color: var(--text-muted); margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 0.05em;">Global Network</div>
        <a href="/common/stock" class="nav-link">Global Stock</a>
        <a href="/common/search" class="nav-link">Search Blood</a>

        <div style="margin-top: auto; border-top: 1px solid rgba(255, 255, 255, 0.1); padding-top: 2rem;">
            <a href="/auth/logout" class="nav-link" style="color: var(--error);">Logout</a>
        </div>
    </nav>
</aside>
